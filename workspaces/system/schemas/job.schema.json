{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Job",
  "description": "Schema for a job in the OpenClaw multi-agent job queue system",
  "type": "object",
  "required": ["job_id", "task_type", "status", "created_at", "attempt", "max_attempts", "input"],
  "properties": {
    "job_id": {
      "type": "string",
      "description": "Unique job identifier (timestamp-based + random hex)"
    },
    "task_type": {
      "type": "string",
      "enum": ["facebook_feed", "facebook_ads_library", "tiktok_analytic", "video_transcript", "facebook_login"],
      "description": "Type of task to execute"
    },
    "status": {
      "type": "string",
      "enum": ["queued", "running", "completed", "failed"],
      "description": "Current job status"
    },
    "owner_agent": {
      "type": "string",
      "description": "Name of the agent/worker that claimed this job"
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO timestamp when job was created"
    },
    "started_at": {
      "type": "string",
      "description": "ISO timestamp when job was claimed and started"
    },
    "finished_at": {
      "type": "string",
      "description": "ISO timestamp when job completed or failed"
    },
    "heartbeat_at": {
      "type": "string",
      "description": "ISO timestamp of the last heartbeat update"
    },
    "attempt": {
      "type": "integer",
      "minimum": 0,
      "description": "Current attempt number"
    },
    "max_attempts": {
      "type": "integer",
      "minimum": 1,
      "default": 3,
      "description": "Maximum number of retry attempts"
    },
    "timeout_seconds": {
      "type": "integer",
      "minimum": 30,
      "description": "Timeout for this job in seconds"
    },
    "priority": {
      "type": "string",
      "enum": ["low", "normal", "high"],
      "default": "normal",
      "description": "Job priority level"
    },
    "input": {
      "type": "object",
      "description": "Task-specific input parameters",
      "properties": {
        "params": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Ordered script arguments"
        }
      }
    },
    "output_path": {
      "type": "string",
      "description": "Relative path to the result file (from project root)"
    },
    "error": {
      "type": "string",
      "description": "Error message if job failed"
    }
  }
}
